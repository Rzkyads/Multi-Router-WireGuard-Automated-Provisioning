# Konfigurasi Server WireGuard (Mock / Dummy untuk Windows)
WG_INTERFACE=wg0
WG_SUBNET_PREFIX=10.10.0
DNS_SERVERS=1.1.1.1, 8.8.8.8
SERVER_PUBLIC_KEY=MOCK_SERVER_PUBKEY_FOR_TESTING_BASE64=
SERVER_ENDPOINT=127.0.0.1:51820
DATABASE_URL=sqlite:///./wireguard.db
SIMULATION_MODE=true

# Konfigurasi MikroTik API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
